rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function deletingAccount() {
      return request.auth != null && exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    match /accountDeletions/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.auth.token.keys().hasAll(['auth_time'])
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time > request.time.toMillis() / 1000 - 300
        && request.auth.token.auth_time <= request.time.toMillis() / 1000 + 60
        && request.resource.data.keys().hasOnly(['uid','requestedAt'])
        && request.resource.data.keys().hasAll(['uid','requestedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.requestedAt == request.time;
      allow list, update, delete: if false;
    }

    function paymentAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/paymentAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/paymentAdmins/$(request.auth.uid)).data.active == true;
    }
    function validPlan(plan,amount) {
      return (plan == 'm1' && amount == 2000) || (plan == 'm3' && amount == 5000)
        || (plan == 'm6' && amount == 8000) || (plan == 'm12' && amount == 10000);
    }
    match /paymentAdmins/{uid} {
      allow get: if signedIn() && (isOwner(uid) || paymentAdmin());
      allow list, write: if false;
    }
    match /accountControls/{uid} {
      allow read: if signedIn() && (isOwner(uid) || paymentAdmin());
      allow create, update: if paymentAdmin() && uid != request.auth.uid
        && !(exists(/databases/$(database)/documents/paymentAdmins/$(uid)) && get(/databases/$(database)/documents/paymentAdmins/$(uid)).data.active == true)
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['uid','status','accessMode','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','status','accessMode','updatedBy','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.status in ['active','suspended']
        && request.resource.data.accessMode in ['automatic','trial-only']
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) && deletingAccount();
    }
    match /users/{uid}/adminMessages/{id} {
      allow read: if isOwner(uid);
      allow create: if paymentAdmin() && !exists(/databases/$(database)/documents/accountDeletions/$(uid))
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['title','body','authorUid','createdAt'])
        && request.resource.data.keys().hasAll(['title','body','authorUid','createdAt'])
        && request.resource.data.title == 'Message from GES Pasco'
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && request.resource.data.authorUid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(uid) && deletingAccount();
    }
    match /momoRequests/{id} {
      allow read: if signedIn() && (paymentAdmin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','kind','planId','amountPesewas','reference','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','kind','planId','amountPesewas','reference','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.reference is string && request.resource.data.reference.matches('^[A-Z0-9-]{6,80}$')
        && request.resource.data.amountPesewas is int
        && ((request.resource.data.kind == 'support' && request.resource.data.planId == '' && request.resource.data.amountPesewas >= 100 && request.resource.data.amountPesewas <= 1000000)
          || (request.resource.data.kind == 'subscription' && validPlan(request.resource.data.planId,request.resource.data.amountPesewas)))
        && !exists(/databases/$(database)/documents/momoReceipts/$(request.resource.data.reference));
      allow update: if paymentAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','endsAtMs'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && request.resource.data.endsAtMs is int
        && ((request.resource.data.status == 'rejected' && request.resource.data.endsAtMs == 0)
          || (request.resource.data.status == 'approved'
            && getAfter(/databases/$(database)/documents/momoReceipts/$(resource.data.reference)).data.requestId == id
            && (resource.data.kind == 'support' ? request.resource.data.endsAtMs == 0
              : (getAfter(/databases/$(database)/documents/subscriptions/$(resource.data.uid)).data.requestId == id
                 && getAfter(/databases/$(database)/documents/subscriptions/$(resource.data.uid)).data.endsAtMs == request.resource.data.endsAtMs))));
      allow delete: if false;
    }
    match /momoReceipts/{reference} {
      allow read: if signedIn() && (paymentAdmin() || resource.data.uid == request.auth.uid);
      allow create: if paymentAdmin()
        && request.resource.data.keys().hasOnly(['requestId','uid','reference','amountPesewas','kind','planId','approvedBy','approvedAt'])
        && request.resource.data.keys().hasAll(['requestId','uid','reference','amountPesewas','kind','planId','approvedBy','approvedAt'])
        && request.resource.data.reference == reference && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.approvedAt == request.time
        && get(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.uid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.reference == reference
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.amountPesewas == request.resource.data.amountPesewas
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.kind == request.resource.data.kind
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.planId == request.resource.data.planId;
      allow update, delete: if false;
    }
    match /subscriptions/{uid} {
      allow read: if signedIn() && (isOwner(uid) || paymentAdmin());
      allow create, update: if paymentAdmin()
        && request.resource.data.keys().hasOnly(['uid','planId','endsAtMs','requestId','updatedBy','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','planId','endsAtMs','requestId','updatedBy','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time && request.resource.data.endsAtMs is int
        && request.resource.data.endsAtMs > request.time.toMillis()
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.kind == 'subscription'
        && get(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.endsAtMs == request.resource.data.endsAtMs
        && getAfter(/databases/$(database)/documents/momoRequests/$(request.resource.data.requestId)).data.planId == request.resource.data.planId
        && (!exists(/databases/$(database)/documents/subscriptions/$(uid)) || request.resource.data.requestId != resource.data.requestId);
      allow delete: if false;
    }

    function validProfileShape() {
      return request.resource.data.keys().hasOnly([
               'displayName', 'email', 'role', 'accountStatus',
               'createdAt', 'lastLoginAt'
             ])
             && request.resource.data.keys().hasAll([
               'displayName', 'email', 'role', 'accountStatus',
               'createdAt', 'lastLoginAt'
             ])
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() <= 120
             && request.resource.data.email is string
             && request.resource.data.email == request.auth.token.email
             && request.resource.data.role == 'user'
             && request.resource.data.accountStatus == 'active'
             && request.resource.data.createdAt is timestamp
             && (request.resource.data.lastLoginAt == null
                 || request.resource.data.lastLoginAt is timestamp);
    }

    function adminFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
             && request.resource.data.accountStatus == resource.data.accountStatus
             && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validPosition() {
      return request.resource.data.keys().hasOnly([
               'location', 'progress', 'chapter', 'lastRead', 'updatedAt'
             ])
             && request.resource.data.keys().hasAll([
               'location', 'progress', 'chapter', 'lastRead', 'updatedAt'
             ])
             && request.resource.data.location is string
             && request.resource.data.location.size() > 0
             && request.resource.data.location.size() <= 10000
             && request.resource.data.progress is number
             && request.resource.data.progress >= 0
             && request.resource.data.progress <= 100
             && request.resource.data.chapter is string
             && request.resource.data.chapter.size() <= 2000
             && request.resource.data.lastRead is string
             && request.resource.data.lastRead.size() <= 64
             && request.resource.data.updatedAt is timestamp;
    }

    function validPreferences() {
      return request.resource.data.keys().hasOnly([
               'theme', 'fontSize', 'fontFamily', 'lastChanged', 'updatedAt'
             ])
             && request.resource.data.keys().hasAll([
               'theme', 'fontSize', 'fontFamily', 'lastChanged', 'updatedAt'
             ])
             && request.resource.data.theme is string
             && request.resource.data.theme.size() <= 40
             && request.resource.data.fontSize is number
             && request.resource.data.fontSize >= 50
             && request.resource.data.fontSize <= 250
             && request.resource.data.fontFamily is string
             && request.resource.data.fontFamily.size() <= 120
             && request.resource.data.lastChanged is string
             && request.resource.data.lastChanged.size() <= 64
             && request.resource.data.updatedAt is timestamp;
    }

    function validBookmark() {
      return request.resource.data.keys().hasOnly([
               'cfi', 'chapter', 'progress', 'date', 'updatedAt', 'deleted'
             ])
             && request.resource.data.keys().hasAll([
               'cfi', 'chapter', 'progress', 'date', 'updatedAt'
             ])
             // v1.0.7 omits deleted; v1.0.8 includes a boolean tombstone flag.
             && (!('deleted' in request.resource.data)
                 || request.resource.data.deleted is bool)
             && request.resource.data.cfi is string
             && request.resource.data.cfi.size() > 0
             && request.resource.data.cfi.size() <= 10000
             && request.resource.data.chapter is string
             && request.resource.data.chapter.size() <= 2000
             && request.resource.data.progress is number
             && request.resource.data.progress >= 0
             && request.resource.data.progress <= 100
             && request.resource.data.date is string
             && request.resource.data.date.size() <= 64
             && request.resource.data.updatedAt is timestamp;
    }

    // Reviewer access is granted only through the trusted Firebase Console/Admin SDK.
    function isReportAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/reportAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/reportAdmins/$(request.auth.uid)).data.active == true;
    }
    function reportText(value, maximum) { return value is string && value.size() <= maximum; }
    function validQuestionSnapshot(q) {
      return q is map
        && q.keys().hasOnly(['id','bankId','bankTitle','prompt','options','answerIndex','source'])
        && q.keys().hasAll(['id','bankId','bankTitle','prompt','options','answerIndex','source'])
        && reportText(q.id,180) && q.id.size() > 0
        && reportText(q.bankId,100) && q.bankId.size() > 0
        && reportText(q.bankTitle,200) && q.bankTitle.size() > 0
        && reportText(q.prompt,6000) && q.prompt.size() > 0
        && reportText(q.source,1000) && q.source.size() > 0
        && q.options is list && q.options.size() >= 2 && q.options.size() <= 6
        && reportText(q.options[0],1500) && reportText(q.options[1],1500)
        && (q.options.size() < 3 || reportText(q.options[2],1500))
        && (q.options.size() < 4 || reportText(q.options[3],1500))
        && (q.options.size() < 5 || reportText(q.options[4],1500))
        && (q.options.size() < 6 || reportText(q.options[5],1500))
        && q.answerIndex is int && q.answerIndex >= 0 && q.answerIndex < q.options.size();
    }
    function validQuestionReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reporterUid','question','category','description','suggestion','status','createdAt','updatedAt','reviewNote','reviewedBy','reviewedAt','appVersion','queuedAtMs'])
        && d.keys().hasAll(['reporterUid','question','category','description','suggestion','status','createdAt','updatedAt','reviewNote','reviewedBy','reviewedAt','appVersion','queuedAtMs'])
        && d.reporterUid == request.auth.uid && validQuestionSnapshot(d.question)
        && d.category in ['wrong_answer','unclear','typo','missing_content','other']
        && reportText(d.description,2000) && d.description.size() > 0
        && reportText(d.suggestion,2000) && d.status == 'new'
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.reviewNote == '' && d.reviewedBy == '' && d.reviewedAt == null
        && reportText(d.appVersion,40)
        && d.queuedAtMs is int && d.queuedAtMs > 0 && d.queuedAtMs < 1000000000000000;
    }
    match /reportAdmins/{adminUid} {
      allow get: if isOwner(adminUid);
      allow delete: if isOwner(adminUid) && deletingAccount();
      allow list, create, update: if false;
    }
    match /questionReports/{reportId} {
      allow create: if signedIn() && validQuestionReport();
      // An absent random-ID document contains no private data; clients check it for retry idempotency.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/questionReports/$(reportId))
        || isReportAdmin() || resource.data.reporterUid == request.auth.uid);
      allow list: if isReportAdmin() || isOwner(resource.data.reporterUid);
      allow update: if isReportAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewNote','reviewedBy','reviewedAt','updatedAt'])
        && request.resource.data.status in ['new','under_review','corrected','closed']
        && reportText(request.resource.data.reviewNote,2000)
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if deletingAccount() && isOwner(resource.data.reporterUid);
    }

    match /announcements/{noticeId} {
      allow read: if signedIn();
      allow create: if isReportAdmin()
        && request.resource.data.keys().hasOnly(['title','body','createdAt','authorUid'])
        && request.resource.data.keys().hasAll(['title','body','createdAt','authorUid'])
        && reportText(request.resource.data.title,120) && request.resource.data.title.size() > 0
        && reportText(request.resource.data.body,2000) && request.resource.data.body.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isReportAdmin();
    }
    match /users/{userId}/notifications/{reportId} {
      allow read: if isOwner(userId);
      allow create, update: if isReportAdmin()
        && !exists(/databases/$(database)/documents/accountDeletions/$(userId))
        && request.resource.data.keys().hasOnly(['reportId','body','status','updatedAt'])
        && request.resource.data.keys().hasAll(['reportId','body','status','updatedAt'])
        && request.resource.data.reportId == reportId
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/questionReports/$(reportId)).data.reporterUid == userId
        && getAfter(/databases/$(database)/documents/questionReports/$(reportId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/questionReports/$(reportId)).data.reviewedBy == request.auth.uid
        && request.resource.data.body == getAfter(/databases/$(database)/documents/questionReports/$(reportId)).data.reviewNote
        && request.resource.data.status == getAfter(/databases/$(database)/documents/questionReports/$(reportId)).data.status;
      allow delete: if isOwner(userId) && deletingAccount();
    }
    match /users/{userId}/inboxReads/{noticeId} {
      allow read: if isOwner(userId);
      allow create, update: if signedIn() && isOwner(userId)
        && request.resource.data.keys().hasOnly(['seenVersion'])
        && request.resource.data.keys().hasAll(['seenVersion'])
        && request.resource.data.seenVersion is int
        && request.resource.data.seenVersion >= 0;
      allow delete: if isOwner(userId) && deletingAccount();
    }

    // Quiz editors are trusted reviewers. All published content is readable by signed-in users;
    // drafts remain private. Every client also validates individual questions before use.
    function validQuizBank(bank, bankId) {
      return bank is map
        && bank.keys().hasOnly(['schema','id','title','questions','version'])
        && bank.keys().hasAll(['schema','id','title','questions'])
        && bank.schema == 1 && bank.id == bankId
        && bankId.matches('[-a-z0-9]{1,60}')
        && reportText(bank.title,200) && bank.title.size() > 0
        && bank.questions is list && bank.questions.size() >= 1 && bank.questions.size() <= 100
        && (!('version' in bank) || (bank.version is int && bank.version >= 1));
    }
    match /quizDrafts/{bankId} {
      allow read: if isReportAdmin();
      allow create, update: if isReportAdmin()
        && request.resource.data.keys().hasOnly(['bank','revision','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['bank','revision','updatedAt','updatedBy'])
        && validQuizBank(request.resource.data.bank,bankId)
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/quizDrafts/$(bankId)) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/quizDrafts/$(bankId)) && request.resource.data.revision == resource.data.revision + 1))
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /quizBanks/{bankId} {
      allow read: if signedIn();
      allow create, update: if isReportAdmin()
        && request.resource.data.keys().hasOnly(['bank','version','enabled','reviewed','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['bank','version','enabled','reviewed','updatedAt','updatedBy'])
        && validQuizBank(request.resource.data.bank,bankId)
        && request.resource.data.enabled is bool && request.resource.data.reviewed == true
        && request.resource.data.version is int
        && ((!exists(/databases/$(database)/documents/quizBanks/$(bankId)) && request.resource.data.version == 1)
          || (exists(/databases/$(database)/documents/quizBanks/$(bankId)) && request.resource.data.version == resource.data.version + 1))
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId} {
      allow create: if signedIn() && isOwner(userId) && validProfileShape();
      allow read: if isOwner(userId) || paymentAdmin();

      // Ordinary users may refresh their own name/email/login timestamp,
      // but cannot change role, accountStatus or createdAt.
      allow update: if signedIn() && isOwner(userId)
                    && validProfileShape()
                    && adminFieldsUnchanged();

      allow delete: if isOwner(userId) && deletingAccount();

      match /readerData/default {
        allow read: if isOwner(userId);
        allow create, update: if signedIn() && isOwner(userId) && validPosition();
        allow delete: if isOwner(userId) && deletingAccount();
      }

      match /readerData/preferences {
        allow read: if isOwner(userId);
        allow create, update: if signedIn() && isOwner(userId) && validPreferences();
        allow delete: if isOwner(userId) && deletingAccount();
      }

      match /practiceResults/{resultId} {
        allow read: if isOwner(userId);
        allow create: if signedIn() && isOwner(userId)
          && request.resource.data.keys().hasOnly(['recordId','finishedAtMs','payload'])
          && request.resource.data.keys().hasAll(['recordId','finishedAtMs','payload'])
          && request.resource.data.recordId is string && request.resource.data.recordId.size() > 0 && request.resource.data.recordId.size() <= 400
          && request.resource.data.finishedAtMs is int && request.resource.data.finishedAtMs > 0
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000;
        allow update: if signedIn() && isOwner(userId) && request.resource.data == resource.data;
        allow delete: if isOwner(userId) && deletingAccount();
      }

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow create, update: if signedIn() && isOwner(userId) && validBookmark();
        allow delete: if isOwner(userId);
      }

      // Deny any unplanned subcollections/documents under a user.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Everything outside the explicitly declared structure is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
